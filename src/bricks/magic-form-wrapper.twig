<header>
	<i class="{{ handler.translate('icon.large', 'fad fa-rocket') }}"></i>
	<label>{{ head.label ? head.label : handler.translate('label.form', handler.name) }}</label>
	<var>id: {{ head.id ? head.id : 'new' }}{% if head.guid %} | guid: {{ head.guid }}{% endif %}</var>
	<nav>
		{% for button in buttons %}
			<div (form-button) is="{{ button.tag }}" {% for prop, value in button.data %} data-{{ prop }} = "{{ value }}" {% endfor %} data-handler="{{ handler.name }}" data-id="{{ id }}"></div>
		{% endfor %}
	</nav>
</header>

<form (form-body) is="{{ form }}" data-handler="{{ handler.name }}"></form>