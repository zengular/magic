<header>
	<i class="{{ handler.icon.large }}"></i>
	<label>{{ head.label ? head.label : handler.form.title }}</label>
	<var>id: {{ head.id ? head.id : 'new' }}{% if head.guid %} | guid: {{ head.guid }}{% endif %}</var>
	<nav>
		{% for button in buttons %}
			<div (form-button) is="{{ button }}" data-handler="{{ handler.name }}" data-id="{{ id }}"></div>
		{% endfor %}
	</nav>
</header>

<form (form-body) is="{{ form }}"></form>